generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  WHOLESALER
  ADMIN
}

enum WholesaleApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

// Auth.js (NextAuth v5) Prisma Adapter schema — https://authjs.dev/getting-started/adapters/prisma

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          UserRole  @default(CUSTOMER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts         Account[]
  sessions         Session[]
  carts            Cart[]
  orders           Order[]
  addresses        Address[]
  wholesaleAccount WholesaleAccount?
  customRequests   CustomRequest[]

  @@index([role])
}

model WholesaleAccount {
  id                String                  @id @default(cuid())
  userId            String                  @unique
  user              User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName      String
  taxId             String?
  phone             String
  applicationNote   String?                 @db.Text
  approvalStatus    WholesaleApprovalStatus @default(PENDING)
  netTermsDays      Int?
  creditLimit       Decimal?                @db.Decimal(10, 2)
  minimumOrderValue Decimal?                @db.Decimal(10, 2)
  stripeCustomerId  String?                 @unique
  reviewedAt        DateTime?
  reviewedBy        String?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  orders Order[]

  @@index([approvalStatus])
}

model Address {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label      String?
  fullName   String
  line1      String
  line2      String?
  city       String
  state      String
  postalCode String
  country    String   @default("US")
  phone      String?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  // No standalone @unique here — only the compound key below. A bare-unique
  // token would mean two different users who happen to be issued the same
  // random 6-digit OTP code (identifier differs, code collides) fail to
  // insert with a unique-constraint violation instead of just working, since
  // each user's token is only ever looked up by (identifier, token) together.
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// ── Catalog ───────────────────────────────────────────

enum ProductCategorySlug {
  BELTS
  WALLETS
  KEYCHAINS
  PURSES
  HANDBAGS
}

model Category {
  id              String              @id @default(cuid())
  slug            ProductCategorySlug @unique
  urlSlug         String              @unique
  name            String
  description     String?             @db.Text
  metaTitle       String?
  metaDescription String?
  sortOrder       Int                 @default(0)

  products Product[]
}

model Product {
  id               String   @id @default(cuid())
  slug             String   @unique
  sku              String   @unique
  categoryId       String
  category         Category @relation(fields: [categoryId], references: [id])
  name             String
  shortDescription String?
  description      String   @db.Text
  isCustomizable   Boolean  @default(false)
  isActive         Boolean  @default(true)
  isFeatured       Boolean  @default(false)
  basePriceRetail  Decimal  @db.Decimal(10, 2)
  basePriceWholesale Decimal? @db.Decimal(10, 2)
  materials        String[]
  metaTitle        String?
  metaDescription  String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  images         ProductImage[]
  variants       ProductVariant[]
  priceBreaks    WholesalePriceBreak[]
  customRequests CustomRequest[]

  @@index([categoryId])
  @@index([isActive, isFeatured])
  @@index([isActive, isCustomizable])
}

model WholesalePriceBreak {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  minQuantity Int
  price       Decimal  @db.Decimal(10, 2)
  createdAt   DateTime @default(now())

  @@unique([productId, minQuantity])
  @@index([productId])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  altText   String
  sortOrder Int     @default(0)
  isPrimary Boolean @default(false)

  @@index([productId])
}

model ProductVariant {
  id                  String   @id @default(cuid())
  productId           String
  product             Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku                    String   @unique
  color                  String?
  size                   String?
  material               String?
  priceRetailOverride    Decimal? @db.Decimal(10, 2)
  priceWholesaleOverride Decimal? @db.Decimal(10, 2)
  stockQuantity          Int      @default(0)
  isActive               Boolean  @default(true)

  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([productId])
}

// ── Cart & Checkout ───────────────────────────────────

enum CartChannel {
  RETAIL
  WHOLESALE
}

model Cart {
  id         String      @id @default(cuid())
  userId     String?
  user       User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel    CartChannel @default(RETAIL)
  guestToken String?     @unique
  updatedAt  DateTime    @updatedAt

  items CartItem[]

  @@unique([userId, channel])
}

model CartItem {
  id               String         @id @default(cuid())
  cartId           String
  cart             Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productVariantId String
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id])
  quantity         Int
  createdAt        DateTime       @default(now())

  @@unique([cartId, productVariantId])
  @@index([cartId])
}

enum OrderStatus {
  INVOICED
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum OrderChannel {
  RETAIL
  WHOLESALE
}

enum OrderPaymentMethod {
  CARD
  INVOICE
}

model Order {
  id                 String              @id @default(cuid())
  orderSequence      Int                 @default(autoincrement())
  orderNumber        String              @unique
  userId             String?
  user               User?               @relation(fields: [userId], references: [id])
  guestEmail         String?
  status             OrderStatus         @default(PAID)
  channel            OrderChannel        @default(RETAIL)
  paymentMethod      OrderPaymentMethod  @default(CARD)
  wholesaleAccountId String?
  wholesaleAccount   WholesaleAccount?   @relation(fields: [wholesaleAccountId], references: [id])

  subtotal      Decimal @db.Decimal(10, 2)
  shippingTotal Decimal @db.Decimal(10, 2)
  taxTotal      Decimal @db.Decimal(10, 2)
  grandTotal    Decimal @db.Decimal(10, 2)
  currency      String  @default("USD")

  shippingAddress Json

  stripeCheckoutSessionId String? @unique
  stripePaymentIntentId   String?
  stripeInvoiceId         String? @unique

  shippingCarrier String?
  trackingNumber  String?
  trackingUrl     String?
  shippedAt       DateTime?
  deliveredAt     DateTime?

  items         OrderItem[]
  statusHistory OrderStatusEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([wholesaleAccountId])
}

model OrderItem {
  id                   String         @id @default(cuid())
  orderId              String
  order                Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productVariantId     String
  productVariant       ProductVariant @relation(fields: [productVariantId], references: [id])
  productNameSnapshot  String
  variantLabelSnapshot String?
  skuSnapshot          String
  quantity             Int
  unitPrice            Decimal        @db.Decimal(10, 2)
  lineTotal            Decimal        @db.Decimal(10, 2)

  @@index([orderId])
}

model OrderStatusEvent {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())

  @@index([orderId])
}

// ── Custom Requests ───────────────────────────────────

enum CustomRequestStatus {
  NEW
  IN_REVIEW
  QUOTED
  APPROVED
  COMPLETED
  DECLINED
}

model CustomRequest {
  id      String  @id @default(cuid())
  userId  String?
  user    User?   @relation(fields: [userId], references: [id])
  name    String
  email   String
  phone   String?

  // Optional link to a product the customer saw on /custom — not required,
  // since fully bespoke requests with no matching product are expected too.
  productId String?
  product   Product? @relation(fields: [productId], references: [id])

  description       String  @db.Text
  budget             String?
  referenceImageUrl  String?
  referenceImageAlt  String?

  status    CustomRequestStatus @default(NEW)
  adminNote String?             @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([userId])
}

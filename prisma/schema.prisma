generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  WHOLESALER
  ADMIN
}

enum WholesaleApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

// Auth.js (NextAuth v5) Prisma Adapter schema — https://authjs.dev/getting-started/adapters/prisma

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          UserRole  @default(CUSTOMER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts         Account[]
  sessions         Session[]
  carts            Cart[]
  orders           Order[]
  addresses        Address[]
  wholesaleAccount WholesaleAccount?
  customRequests   CustomRequest[]
  aiActivityLogs   AiActivityLog[]
  reviews          Review[]

  @@index([role])
}

// Real customer reviews, not fabricated testimonials — the homepage
// "Testimonials" section (see getFeaturedReviews) reuses this same table
// rather than a separate, parallel content type with no real backing data.
// isApproved gates public visibility (moderation queue); isVerifiedPurchase
// is computed at submission time from the reviewer's real order history,
// never self-reported.
model Review {
  id                 String   @id @default(cuid())
  productId          String
  product            Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating             Int
  title              String?
  body               String   @db.Text
  isVerifiedPurchase Boolean  @default(false)
  isApproved         Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([productId, userId])
  @@index([productId, isApproved])
}

model WholesaleAccount {
  id                String                  @id @default(cuid())
  userId            String                  @unique
  user              User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName      String
  // Nullable at the DB level — a handful of accounts were approved before
  // this became a required application field, and existing rows shouldn't
  // retroactively break. New applications enforce it required at the
  // validation layer (see WholesaleApplicationSchema); its presence also
  // drives real Stripe tax-exempt status, not just a copy claim — see
  // src/server/services/wholesale-customer.ts.
  taxId             String?
  phone             String
  website           String?
  storeType         String?
  ein               String?
  businessAddress   Json?
  applicationNote   String?                 @db.Text
  approvalStatus    WholesaleApprovalStatus @default(PENDING)
  netTermsDays      Int?
  creditLimit       Decimal?                @db.Decimal(10, 2)
  minimumOrderValue Decimal?                @db.Decimal(10, 2)
  stripeCustomerId  String?                 @unique
  reviewedAt        DateTime?
  reviewedBy        String?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  orders Order[]

  @@index([approvalStatus])
}

model Address {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label      String?
  fullName   String
  line1      String
  line2      String?
  city       String
  state      String
  postalCode String
  country    String   @default("US")
  phone      String?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  // No standalone @unique here — only the compound key below. A bare-unique
  // token would mean two different users who happen to be issued the same
  // random 6-digit OTP code (identifier differs, code collides) fail to
  // insert with a unique-constraint violation instead of just working, since
  // each user's token is only ever looked up by (identifier, token) together.
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// ── Catalog ───────────────────────────────────────────

enum ProductCategorySlug {
  BELTS
  WALLETS
  KEYCHAINS
  PURSES
  HANDBAGS
}

model Category {
  id              String              @id @default(cuid())
  slug            ProductCategorySlug @unique
  urlSlug         String              @unique
  name            String
  description     String?             @db.Text
  metaTitle       String?
  metaDescription String?
  sortOrder       Int                 @default(0)

  products Product[]
}

model Product {
  id                 String   @id @default(cuid())
  slug               String   @unique
  sku                String   @unique
  categoryId         String
  category           Category @relation(fields: [categoryId], references: [id])
  name               String
  shortDescription   String?
  description        String   @db.Text
  isCustomizable     Boolean  @default(false)
  isActive           Boolean  @default(true)
  isFeatured         Boolean  @default(false)
  basePriceRetail    Decimal  @db.Decimal(10, 2)
  basePriceWholesale Decimal? @db.Decimal(10, 2)
  materials          String[]
  // Free-text, admin-editable — not modeled as structured L/W/H fields since
  // real product dimensions vary wildly by category (a belt needs a length
  // range, a bag needs three dimensions, a keychain needs almost none) and a
  // rigid schema would force awkward workarounds. Same reasoning as
  // `description`: one flexible field an admin can format however the piece
  // actually needs, shown as-is on the PDP.
  dimensions         String?
  careInstructions   String?  @db.Text
  metaTitle          String?
  metaDescription    String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  images         ProductImage[]
  variants       ProductVariant[]
  priceBreaks    WholesalePriceBreak[]
  customRequests CustomRequest[]
  reviews        Review[]

  @@index([categoryId])
  @@index([isActive, isFeatured])
  @@index([isActive, isCustomizable])
}

model WholesalePriceBreak {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  minQuantity Int
  price       Decimal  @db.Decimal(10, 2)
  createdAt   DateTime @default(now())

  @@unique([productId, minQuantity])
  @@index([productId])
}

model ProductImage {
  id            String  @id @default(cuid())
  productId     String
  product       Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url           String
  altText       String
  sortOrder     Int     @default(0)
  isPrimary     Boolean @default(false)
  // Tracks AI-generated placeholder photos (vs. real product photography) so
  // admin can find and swap them out later, and the storefront can flag them
  // honestly rather than presenting an AI image as the real product shot.
  isAiGenerated Boolean @default(false)

  @@index([productId])
}

model ProductVariant {
  id                     String   @id @default(cuid())
  productId              String
  product                Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku                    String   @unique
  color                  String?
  size                   String?
  material               String?
  priceRetailOverride    Decimal? @db.Decimal(10, 2)
  priceWholesaleOverride Decimal? @db.Decimal(10, 2)
  stockQuantity          Int      @default(0)
  isActive               Boolean  @default(true)

  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([productId])
}

// ── Cart & Checkout ───────────────────────────────────

enum CartChannel {
  RETAIL
  WHOLESALE
}

model Cart {
  id         String      @id @default(cuid())
  userId     String?
  user       User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel    CartChannel @default(RETAIL)
  guestToken String?     @unique
  updatedAt  DateTime    @updatedAt

  items CartItem[]

  @@unique([userId, channel])
}

model CartItem {
  id               String         @id @default(cuid())
  cartId           String
  cart             Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productVariantId String
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id])
  quantity         Int
  createdAt        DateTime       @default(now())

  @@unique([cartId, productVariantId])
  @@index([cartId])
}

enum OrderStatus {
  INVOICED
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum OrderChannel {
  RETAIL
  WHOLESALE
}

enum OrderPaymentMethod {
  CARD
  INVOICE
}

model Order {
  id                 String             @id @default(cuid())
  orderSequence      Int                @default(autoincrement())
  orderNumber        String             @unique
  userId             String?
  user               User?              @relation(fields: [userId], references: [id])
  guestEmail         String?
  status             OrderStatus        @default(PAID)
  channel            OrderChannel       @default(RETAIL)
  paymentMethod      OrderPaymentMethod @default(CARD)
  wholesaleAccountId String?
  wholesaleAccount   WholesaleAccount?  @relation(fields: [wholesaleAccountId], references: [id])

  subtotal      Decimal @db.Decimal(10, 2)
  shippingTotal Decimal @db.Decimal(10, 2)
  taxTotal      Decimal @db.Decimal(10, 2)
  grandTotal    Decimal @db.Decimal(10, 2)
  currency      String  @default("USD")

  shippingAddress Json

  stripeCheckoutSessionId String? @unique
  stripePaymentIntentId   String?
  stripeInvoiceId         String? @unique

  shippingCarrier String?
  trackingNumber  String?
  trackingUrl     String?
  shippedAt       DateTime?
  deliveredAt     DateTime?

  // Cumulative — supports partial refunds without a separate ledger table
  // (a real per-refund audit trail already exists via OrderStatusEvent's
  // notes, which record each individual refund amount and Stripe refund id).
  amountRefunded Decimal?  @db.Decimal(10, 2)
  refundedAt     DateTime?

  items         OrderItem[]
  statusHistory OrderStatusEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([wholesaleAccountId])
}

model OrderItem {
  id                   String         @id @default(cuid())
  orderId              String
  order                Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productVariantId     String
  productVariant       ProductVariant @relation(fields: [productVariantId], references: [id])
  productNameSnapshot  String
  variantLabelSnapshot String?
  skuSnapshot          String
  quantity             Int
  unitPrice            Decimal        @db.Decimal(10, 2)
  lineTotal            Decimal        @db.Decimal(10, 2)

  @@index([orderId])
}

model OrderStatusEvent {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())

  @@index([orderId])
}

// ── Custom Requests ───────────────────────────────────

enum CustomRequestStatus {
  NEW
  IN_REVIEW
  QUOTED
  APPROVED
  COMPLETED
  DECLINED
}

model CustomRequest {
  id     String  @id @default(cuid())
  userId String?
  user   User?   @relation(fields: [userId], references: [id])
  name   String
  email  String
  phone  String?

  // Optional link to a product the customer saw on /custom — not required,
  // since fully bespoke requests with no matching product are expected too.
  productId String?
  product   Product? @relation(fields: [productId], references: [id])

  description String               @db.Text
  budget      String?
  images      CustomRequestImage[]

  status    CustomRequestStatus @default(NEW)
  adminNote String?             @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([userId])
}

model CustomRequestImage {
  id              String        @id @default(cuid())
  customRequestId String
  customRequest   CustomRequest @relation(fields: [customRequestId], references: [id], onDelete: Cascade)
  url             String
  altText         String
  sortOrder       Int           @default(0)
  createdAt       DateTime      @default(now())

  @@index([customRequestId])
}

model AiActivityLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  input     Json
  output    Json
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([type])
}

// ── Content / CMS ──────────────────────────────────────

// Admin-editable static pages (About, FAQ, Shipping, Returns, etc.) — a
// dynamic [slug] route at the top of the retail route group renders these.
// Content is stored as plain text with blank-line paragraph breaks (no rich
// text / no dangerouslySetInnerHTML) — simple and has zero XSS surface,
// matching "treat every input as malicious" for admin-authored content that
// still passes through a browser render path.
model ContentPage {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  content         String   @db.Text
  metaTitle       String?
  metaDescription String?
  showInFooter    Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([slug])
}

// Homepage newsletter signup. Deliberately just a capture table for now — no
// campaign-sending infrastructure exists (that would mean a real email
// marketing integration, e.g. Resend Broadcasts or a dedicated ESP, which is
// out of scope here). This makes the signup form genuinely functional
// (real rows, real duplicate-email handling) without pretending a "Sign up
// for our newsletter" promise is backed by campaigns that don't exist yet.
model NewsletterSubscriber {
  id           String   @id @default(cuid())
  email        String   @unique
  subscribedAt DateTime @default(now())
}

// The Contact page's actual delivery mechanism — every submission is
// persisted here (not just emailed) so nothing gets lost if the outbound
// email hiccups, and admin has a durable record independent of an inbox.
model ContactMessage {
  id          String   @id @default(cuid())
  name        String
  email       String
  orderNumber String?
  message     String   @db.Text
  isResolved  Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([isResolved, createdAt])
}

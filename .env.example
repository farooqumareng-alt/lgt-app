DATABASE_URL="postgresql://lgt:lgt@localhost:5432/lgt_dev?schema=public"

# Only needed when DATABASE_URL is a pooled connection (e.g. Supabase's transaction
# pooler, port 6543) — DIRECT_URL should be the non-pooled connection (port 5432),
# used only for running migrations. Leave unset for local docker-compose Postgres.
# DIRECT_URL="postgresql://..."

# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me"
AUTH_URL="http://localhost:3000"

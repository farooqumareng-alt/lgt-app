DATABASE_URL="postgresql://lgt:lgt@localhost:5432/lgt_dev?schema=public"

# When deploying against a pooled connection (e.g. Supabase's transaction pooler,
# port 6543), DATABASE_URL above is what the app uses at runtime. Running
# `prisma migrate deploy`/`migrate dev` against a pooler doesn't work reliably —
# temporarily override DATABASE_URL with a session/direct (non-transaction-pooled)
# connection string just for that command instead, e.g.:
#   DATABASE_URL="<session-pooler-or-direct-url>" npx prisma migrate deploy

# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me"
AUTH_URL="http://localhost:3000"

DATABASE_URL="postgresql://lgt:lgt@localhost:5432/lgt_dev?schema=public"

# When deploying against a pooled connection (e.g. Supabase's transaction pooler,
# port 6543), DATABASE_URL above is what the app uses at runtime. Running
# `prisma migrate deploy`/`migrate dev` against a pooler doesn't work reliably —
# temporarily override DATABASE_URL with a session/direct (non-transaction-pooled)
# connection string just for that command instead, e.g.:
#   DATABASE_URL="<session-pooler-or-direct-url>" npx prisma migrate deploy
#
# Supabase's direct connection host (db.<project-ref>.supabase.co) resolves to
# an IPv6-only address — Vercel's build environment can't reach it and fails
# with ENETUNREACH. Always use the pooler host (aws-*.pooler.supabase.com) for
# the runtime DATABASE_URL, never the direct one.
#
# A newer pg-connection-string version also changed `sslmode=require` to mean
# full certificate verification (was: encrypt without verifying). Supabase's
# pooler certificate chain fails that stricter check with "self-signed
# certificate in certificate chain" — append `&uselibpqcompat=true` to restore
# the traditional "encrypt, don't verify" behavior psql/libpq still uses:
#   postgresql://postgres.<project-ref>:<password>@aws-<n>-<region>.pooler.supabase.com:6543/postgres?sslmode=require&uselibpqcompat=true

# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me"
AUTH_URL="http://localhost:3000"

# Stripe dashboard → Developers → API keys (test mode)
STRIPE_SECRET_KEY="sk_test_replace-me"
STRIPE_PUBLISHABLE_KEY="pk_test_replace-me"
# From `stripe listen` locally, or the webhook endpoint's signing secret in prod
STRIPE_WEBHOOK_SECRET="whsec_replace-me"
